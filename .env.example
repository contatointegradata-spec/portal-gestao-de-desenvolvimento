# ─── Email (recuperacao de senha) ─────────────────────────────────────────────
MAIL_USER=seu_email@gmail.com
MAIL_APP_PASSWORD=sua_google_app_password
MAIL_FROM=seu_email@gmail.com

# URL publica do frontend
FRONTEND_URL=http://localhost:5173

# ─── Docker / VPS ─────────────────────────────────────────────────────────────
# Interface onde o docker-compose publica as portas 5174 (app) e 6080 (ao vivo).
# Padrao 127.0.0.1: na VPS o nginx faz o proxy. Use 0.0.0.0 para expor direto.
# APP_BIND=127.0.0.1
# APP_PORT=5174
# LIVE_VIEW_PORT=6080

# ─── Banco e seguranca ────────────────────────────────────────────────────────
DB_PATH=data/gestao_dev.sqlite
# Chave de criptografia das credenciais de API. Se vazia, o servidor gera
# data/.gestao-secret.key (faca backup junto com o banco).
APP_SECRET_KEY=
SESSION_DURATION_DAYS=7

# Usuario master: criado somente se ainda nao existir no banco.
# A senha do master existente NUNCA e alterada pelo servidor.
MASTER_EMAIL=admin@integradata.local
MASTER_NAME=Kelven Silva
MASTER_PASSWORD=

# ─── RPA ──────────────────────────────────────────────────────────────────────
APP_TIMEZONE=America/Sao_Paulo
# PYTHON_BIN=python          # Windows: python | Linux/Docker: python3
RPA_MAX_CONCURRENT=3
RPA_DEFAULT_TIMEOUT_SECONDS=600
RPA_MAX_TIMEOUT_SECONDS=86400
RPA_MAX_FILE_MB=25
# RPA_HEADLESS=1             # forca headless em todos os RPAs em modo "automatico"
# RPA_LIVE_VIEW_PORT=6080    # porta do noVNC que transmite o navegador ao vivo (0 desativa)
# RPA_LIVE_VIEW_URL=         # URL publica do noVNC atras de proxy (ex.: https://gestaodev.integradata.app.br/live-view)
